# Dependencies, framework caches and build output
node_modules/
.next/
.vinext/
dist/
out/
coverage/
.turbo/
.cache/
tmp/
temp/
*.tmp

# Generated runtime files and local Cloudflare state
src/generated/prisma/
worker-configuration.d.ts
.wrangler/

# Local environment files; only safe examples may be versioned
.env
.env.*
!.env.example
!.env.*.example
.prisma.env
.dev.vars
.dev.vars.*
!.dev.vars.example
!.prisma.env.example

# Local SQLite/D1 databases and journals
*.db
*.db-*
*.db-journal
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Manual exports, backups and commercial data must stay out of Git
backups/
exports/
*.backup
*.bak
*.dump
*.csv
*.tsv
*.xls
*.xlsx

# Logs and accidental secret scratch files
*.log
logs/
Segredo.txt
*.secret
*.secrets
